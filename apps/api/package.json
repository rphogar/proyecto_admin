{
  "name": "@contave/api",
  "version": "0.0.0",
  "private": true,
  "description": "API NestJS + jobs BullMQ. Solo bootstrap (health) en P0.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:bootstrap-roles": "tsx src/db/bootstrap-roles.ts",
    "db:seed-demo": "tsx src/db/seed-demo.ts",
    "db:provisionar-owner": "tsx src/db/provisionar-owner.ts",
    "drill:invariantes": "tsx src/seguridad/drill-invariantes.ts",
    "homologacion:solicitar": "tsx src/cumplimiento/solicitar-homologacion.ts"
  },
  "dependencies": {
    "@contave/fiscal-engine": "workspace:*",
    "@contave/imprenta-digital": "workspace:*",
    "@contave/impresora-fiscal": "workspace:*",
    "@contave/ledger": "workspace:*",
    "@contave/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@react-pdf/renderer": "^4.1.6",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.38.3",
    "ioredis": "^5.4.2",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.1",
    "@types/react": "^19.0.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.30.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}

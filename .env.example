# Copiar a .env y ajustar. NUNCA commitear .env (regla 14 de CLAUDE.md).
NODE_ENV=development

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=contave
POSTGRES_PASSWORD=contave_dev
POSTGRES_DB=contave
# Owner: migraciones y bootstrap del rol de aplicación (drizzle-kit, db:bootstrap-roles).
DATABASE_URL=postgresql://contave:contave_dev@localhost:5432/contave
# Rol de aplicación SIN BYPASSRLS: lo usa la API en runtime para que RLS la gobierne (P2).
# Creado por `pnpm --filter @contave/api db:bootstrap-roles` antes de `db:migrate`.
APP_DATABASE_URL=postgresql://contave_app:contave_app_dev@localhost:5432/contave
APP_DB_PASSWORD=contave_app_dev

# --- Redis (docker-compose, jobs BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- API (NestJS) ---
API_PORT=3001

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
